# 検証用の環境の情報などを含むので公開しない
CLAUDE.md

# ローカルのパスを含むので共有しない
.claude/settings.json

# 環境変数（機密情報）。.env.example は管理する
.env

# 証明書・秘密鍵（certs/ は compose がマウントする provisioner 用の証明書の置き場所）
*.pem
*.key
/certs/
# Cloudflare Tunnel のトークン（compose の cloudflared がマウントする）
/secrets/
# 監査ログの日ごとのファイル（compose がマウントする）
/audit/
# DB のバックアップ（運用ガイド 11 章）
/backups/

# リポジトリ直下で go build したときの成果物
/aka-ossbss

# 生成した CSS（Docker のビルドの段で作る）
/internal/web/static/app.css

# テストとカバレッジ
*.test
*.out
coverage.*
*.coverprofile

# エディター
*.swp
*~

# CSS の生成に使うファイル（scripts/build-css.sh が取得する）
/.cache/
/internal/web/css/daisyui.mjs
