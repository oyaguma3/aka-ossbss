# compose の設定。cp .env.example .env して書き換える（.env は chmod 600 にする）。

# 重ねる compose ファイル。
COMPOSE_FILE=compose.yaml

# 本BFF 専用の PostgreSQL のパスワード（必須）。例: openssl rand -hex 24 の出力。
OSSBSS_DB_PASSWORD=change-me

# Cloudflare Access（必須。設計概要 §5）。チームのドメイン（<チーム名>.cloudflareaccess.com）と、
# Access のアプリの AUD タグ（複数のアプリで使う場合はカンマ区切り）。
OSSBSS_ACCESS_TEAM_DOMAIN=
OSSBSS_ACCESS_AUD=

# 最初のシステム管理者のメールアドレス（必須）。起動のたびに、システム管理者・有効にする。
# provisioner に X-Operator-Id として渡すので、英数字と ._- と @ だけの 64 文字まで（+ は使えない）。
OSSBSS_INITIAL_ADMIN_EMAIL=

# ログのレベル（debug / info / warn / error）。
OSSBSS_LOG_LEVEL=info

# コンテナのタイムゾーン（画面の日時の表示に使う）。
TZ=Asia/Tokyo
