# compose の設定。cp .env.example .env して書き換える（.env は chmod 600 にする）。

# 重ねる compose ファイル。provisioner と同じホストなら compose.aka-provisioner.yaml を重ねる
# （provisioner の共有ネットワークに参加する）。別のホストなら compose.yaml だけにして OSSBSS_PROVISIONER_URL を書く。
# ログを管理面の Fluent Bit（aka-provisioner の compose が動かす）に送るときは compose.fluent-bit.yaml も重ねる。
COMPOSE_FILE=compose.yaml:compose.aka-provisioner.yaml:compose.fluent-bit.yaml

# 管理面の Fluent Bit の口（aka-provisioner の .env の PROVISIONER_FLUENT_BIT_PORT と同じ。compose.fluent-bit.yaml を重ねたとき）。
PROVISIONER_FLUENT_BIT_PORT=24224

# provisioner の共有ネットワークの名前（provisioner の .env の PROVISIONER_SHARED_NETWORK と同じ）。
PROVISIONER_SHARED_NETWORK=aka-provisioner

# Cloudflare Tunnel のトークンは .env に書かず、secrets/tunnel-token に置く（compose の cloudflared が読む。運用ガイド 2.6）。

# aka-ossbss 専用の PostgreSQL のパスワード（必須）。例: openssl rand -hex 24 の出力。
OSSBSS_DB_PASSWORD=change-me

# Cloudflare Access（必須）。チームのドメイン（<チーム名>.cloudflareaccess.com）と、
# Access のアプリの AUD タグ（複数のアプリで使う場合はカンマ区切り）。
OSSBSS_ACCESS_TEAM_DOMAIN=
OSSBSS_ACCESS_AUD=

# 最初のシステム管理者のメールアドレス（必須）。起動のたびに、システム管理者・有効にする。
# provisioner に X-Operator-Id として渡すので、英数字と ._- と @ だけの 64 文字まで（+ は使えない）。
OSSBSS_INITIAL_ADMIN_EMAIL=

# aka-provisioner（API 2.0.0）のベース URL。空なら同一ホストの https://aka-provisioner:9446/admin/v2。
# 別のホストなら VPN 側のアドレス（例 https://100.64.0.30:9446/admin/v2。provisioner のサーバー証明書の SAN に入れる）。
OSSBSS_PROVISIONER_URL=
# クライアント証明書の秘密鍵を別のファイルにした場合だけ、そのコンテナ内のパス（/certs/...）。
OSSBSS_PROVISIONER_CLIENT_KEY=
# provisioner の 1 回の呼び出しの上限時間（provisioner は下流を 1 回だけ呼ぶ。下流の上限は既定 5 秒）。
OSSBSS_PROVISIONER_TIMEOUT=15s

# 一括投入の同時の呼び出しの数（1〜8）。KEK は .env に書かず、secrets/kek に置く（aka-ossbss gen-kek で作る）。
OSSBSS_BULK_CONCURRENCY=5

# ログのレベル（debug / info / warn / error）。
OSSBSS_LOG_LEVEL=info

# コンテナのタイムゾーン（画面の日時の表示に使う）。
TZ=Asia/Tokyo
