# compose の設定。cp .env.example .env して書き換える（.env は chmod 600 にする）。

# 重ねる compose ファイル。provisioner と同じホストなら compose.eapaka-provisioner.yaml を重ねる
# （provisioner の共有ネットワークに参加する）。別のホストなら compose.yaml だけにして OSSBSS_PROVISIONER_URL を書く。
COMPOSE_FILE=compose.yaml:compose.eapaka-provisioner.yaml

# provisioner の共有ネットワークの名前（provisioner の .env の PROVISIONER_SHARED_NETWORK と同じ）。
PROVISIONER_SHARED_NETWORK=eapaka-provisioner

# 本BFF 専用の PostgreSQL のパスワード（必須）。例: openssl rand -hex 24 の出力。
OSSBSS_DB_PASSWORD=change-me

# Cloudflare Access（必須。設計概要 §5）。チームのドメイン（<チーム名>.cloudflareaccess.com）と、
# Access のアプリの AUD タグ（複数のアプリで使う場合はカンマ区切り）。
OSSBSS_ACCESS_TEAM_DOMAIN=
OSSBSS_ACCESS_AUD=

# 最初のシステム管理者のメールアドレス（必須）。起動のたびに、システム管理者・有効にする。
# provisioner に X-Operator-Id として渡すので、英数字と ._- と @ だけの 64 文字まで（+ は使えない）。
OSSBSS_INITIAL_ADMIN_EMAIL=

# eapaka-node-provisioner のベース URL。空なら同一ホストの https://eapaka-provisioner:9446/admin/v1。
# 別のホストなら VPN 側のアドレス（例 https://100.64.0.30:9446/admin/v1。provisioner のサーバー証明書の SAN に入れる）。
OSSBSS_PROVISIONER_URL=
# クライアント証明書の秘密鍵を別のファイルにした場合だけ、そのコンテナ内のパス（/certs/...）。
OSSBSS_PROVISIONER_CLIENT_KEY=
# provisioner の 1 回の呼び出しの上限時間。
OSSBSS_PROVISIONER_TIMEOUT=60s

# ログのレベル（debug / info / warn / error）。
OSSBSS_LOG_LEVEL=info

# コンテナのタイムゾーン（画面の日時の表示に使う）。
TZ=Asia/Tokyo
